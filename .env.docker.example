# Настройки self-hosted развёртывания: скопируйте в .env рядом с
# docker-compose.yml и заполните. Файл с реальными значениями в репозиторий
# не коммитится (.env уже в .gitignore).

# ── адрес приложения. APP_BASE_URL нужен всегда (GoTrue site_url, ссылки в
# письмах/пушах, и NEXT_PUBLIC_SUPABASE_URL=$APP_BASE_URL/supabase — и
# браузер, и сам сервер ходят на Supabase-совместимый API через приложение,
# см. next.config.mjs). APP_DOMAIN — только для боевого запуска (сертификат
# Caddy, см. docker-compose.vps.yml); для локальной отладки не нужен.
#   локально: http://localhost:3001 (см. docker-compose.local.yml — порт
#             3000 может быть занят другим стендом, важно чтобы внешний и
#             внутренний порт совпадали, см. комментарий в этом файле)
#   VPS:      https://sendera.example.ru
APP_BASE_URL=https://sendera.example.ru
# домен для сертификата (без https://)
APP_DOMAIN=sendera.example.ru

# ── база: длинный случайный пароль (openssl rand -hex 24)
POSTGRES_PASSWORD=

# ── ключи Supabase-совместимых сервисов (db/auth/rest/storage за gateway).
# JWT_SECRET — случайная строка не короче 32 символов (openssl rand -hex 32).
# ANON и SERVICE_ROLE — JWT-токены, подписанные этим секретом:
#   node scripts/gen-keys.mjs "$JWT_SECRET"
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── образ приложения (собирается на стороне GitHub, см.
# .github/workflows/docker-build.yml). Локально можно оставить пустым —
# docker-compose.yml соберёт из исходников сам (sendera-app:local).
#   ghcr.io/<владелец>/<репозиторий>:latest
APP_IMAGE=
# пакет в ghcr.io приватный — токен с правом read:packages для входа на
# VPS (Settings → Developer settings → Personal access tokens, classic,
# scope read:packages). Логин — обычно ваш GitHub-логин.
GHCR_USER=
GHCR_TOKEN=

# ── VAPID-ключи для web push (уже есть от текущего облачного деплоя — можно
# перенести как есть; смена ключей отпишет всех текущих подписчиков)
#   npm run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── секрет для внутренних вызовов cron-эндпоинтов приложения (см. migration
# 0090_cron_app_config.sql — pg_cron дёргает их сам изнутри докер-сети;
# openssl rand -hex 32)
CRON_SECRET=

# ── подпись ссылок отписки в письмах/SMS (openssl rand -hex 32)
UNSUBSCRIBE_SECRET=

# ── подпись служебных параметров OIDC-входа (sid/sig сессии, continue-
# редирект, device-recognition кука) — lib/oidc.ts. Обязателен: без него
# вход по OIDC падает сразу (openssl rand -hex 32)
OIDC_STATE_SECRET=

# ── CloudPayments (биллинг) — тестовые или боевые ключи; без них кнопки
# оплаты просто неактивны, остальное приложение работает
CLOUDPAYMENTS_PUBLIC_ID=
NEXT_PUBLIC_CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# ── исходящий прокси для Telegram Gateway (нужен, если сервер в РФ)
OUTBOUND_PROXY_URL=
