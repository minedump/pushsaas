# HTTPS с автоматическим сертификатом Let's Encrypt.
#
# Сертификат выпускается сам при первом обращении по домену и продлевается
# в фоне. Нужны две вещи: домен указывает на сервер, порты 80 и 443
# доступны снаружи.
#
# Наружу открыто только само приложение: база, auth, доступ к таблицам и
# файловое хранилище остаются во внутренней сети докера — /supabase/* тоже
# проксирует само приложение (см. next.config.mjs), Caddy об этом не знает.
{$APP_DOMAIN} {
	encode gzip
	reverse_proxy app:3000 {
		# Адрес клиента приложение берёт из последнего элемента X-Forwarded-For —
		# его дописывает Caddy. Заодно перезаписываем X-Real-IP своим значением,
		# чтобы одноимённый заголовок от клиента не доехал до приложения:
		# подставным адресом обходились все ограничения частоты.
		header_up X-Real-IP {remote_host}
	}
}
