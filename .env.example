# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never exposed to browser

# ---- Web Push (platform-level fallback / demo project) ----
# Per-project VAPID keys are generated at project creation and stored in project_secrets.
# These are only used for the local demo/test sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:arduetrue@gmail.com

# ---- CloudPayments (billing) ----
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
NEXT_PUBLIC_CLOUDPAYMENTS_PUBLIC_ID=   # same Public ID, exposed to the payment widget

# ---- Cron secret (protects renew-subscriptions & scheduled-send routes) ----
CRON_SECRET=change-me-to-a-long-random-string

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Outbound proxy ----
# Некоторые внешние API (подтверждено: Telegram Gateway) недоступны напрямую
# с российского хостинга — таймаут на TCP/TLS, не ошибка самого API.
# Формат: http://user:pass@host:port . Пусто — обычный fetch без прокси.
OUTBOUND_PROXY_URL=
